---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/notes/' | absolute_url }}</loc>
  </url>
  {% assign sorted_notes = site.notes | sort: "date" | reverse %}
  {% for note in sorted_notes %}
  <url>
    <loc>{{ note.url | absolute_url }}</loc>
    <lastmod>{{ note.last_modified_at | default: note.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% assign memory_paths = "/memory/yumeshima.html|/memory/kyoto.html|/memory/Cairns.html|/memory/NY.html|/memory/NewYork.html|/memory/SanFrancisco.html|/memory/ApplePark.html|/memory/SanJose.html" | split: "|" %}
  {% for memory_path in memory_paths %}
  <url>
    <loc>{{ memory_path | absolute_url }}</loc>
  </url>
  {% endfor %}
</urlset>
