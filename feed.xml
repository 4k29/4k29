---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
{% assign sorted_notes = site.notes | sort: "date" | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="ja">
  <title>4k29 Notes</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/notes/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/notes/' | absolute_url }}</id>
  <updated>{% if sorted_notes.first %}{{ sorted_notes.first.last_modified_at | default: sorted_notes.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>うまいしか</name>
    <uri>https://x.com/p_horeer</uri>
  </author>
  {% for note in sorted_notes limit: 20 %}
  <entry>
    <title>{{ note.title | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ note.url | absolute_url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.last_modified_at | default: note.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ note.description | xml_escape }}</summary>
    {% for tag in note.tags %}
    <category term="{{ tag | xml_escape }}" />
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
