{
  "scope": "Candidate-source quality review before training admission; no model outputs or optimizer updates",
  "selection": {
    "split": "TRAIN only from final duplicate-family union split",
    "hash": "SHA256(foundation-quality-v1|source|documentID|paragraphOrdinal)",
    "completeParagraphCharacters": [80, 1200],
    "maximumPerDocument": 1,
    "maximumPerFamily": 1,
    "maximumPerSource": {"jaquad": 20, "jawikibooks": 30, "jawikivoyage": 30},
    "shortfallPolicy": "Report actual eligible count; do not crop paragraphs or redraw based on apparent quality"
  },
  "reviewFields": [
    "modernJapaneseProse",
    "completeCoherentParagraph",
    "topicOrGenre",
    "dailyLifeOrProcedureRelevance",
    "markupCodeFormulaOrListNoise",
    "priorContextDependency",
    "quotedThirdPartyOrAttributionConcern",
    "humanAuthorshipEvidenceAndUncertainty"
  ],
  "factsVerifiedByThisReview": false,
  "automaticHumanOnlyCertification": false,
  "automaticAdmission": false,
  "noGenerativeRepairOrNewGoldAnswers": true,
  "formalHumanRaterEvaluation": false,
  "reserveIsSealedTest": false,
  "modelInferencePermittedByThisPlan": false,
  "optimizerUpdates": 0
}
