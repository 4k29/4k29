# Preserve exact raw generated text, including trailing spaces.
execution/FULL_GENERATIONS.md whitespace=-blank-at-eol,-blank-at-eof
execution/TRAIN_GENERATIONS.md whitespace=-blank-at-eol,-blank-at-eof
# Preserve GitHub's literal remote warning output in the automatic save log.
execution/automatic-publish.log whitespace=-blank-at-eol,-blank-at-eof

# Preserve literal source snapshots, including their original whitespace.
**/*.html -text whitespace=-blank-at-eol,-blank-at-eof
